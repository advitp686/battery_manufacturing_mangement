<Window x:Class="BatteryManagement.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Battery Management sign in" Width="390" Height="280" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Battery Management" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Sign in to the local workshop system" Foreground="Gray" Margin="0,4,0,20"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Text="admin"/><TextBlock Text="Password" Margin="4,10,4,0"/><PasswordBox x:Name="PasswordBox" Password="ChangeMe123!" Margin="4"/><TextBlock Text="First-run credentials must be changed by the administrator." TextWrapping="Wrap" Foreground="DarkGoldenrod" Margin="4,12"/></StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Exit" Click="Exit_Click"/><Button Content="Sign in" Background="#1769AA" Foreground="White" Click="SignIn_Click"/></StackPanel>
  </Grid>
</Window>
