<Window x:Class="BatteryManagement.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Management sign in"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FB">
  <Border Margin="18" CornerRadius="18" Background="White" Padding="22" BorderBrush="#D7E2EE" BorderThickness="1">
    <StackPanel>
      <Border Width="112" Height="112" CornerRadius="22" Background="#07112E" HorizontalAlignment="Center" Padding="10" Margin="0,0,0,14">
        <Image Source="pack://siteoforigin:,,,/Assets/lithynova_logo.png" Stretch="Uniform" />
      </Border>
      <TextBlock Text="Battery Management" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#102A43" />
      <TextBlock Text="Sign in to the local workshop system" Foreground="#627D98" Margin="0,4,0,18" HorizontalAlignment="Center" />
      <TextBlock Text="Username" Margin="0,0,0,4" FontWeight="Medium" />
      <TextBox x:Name="UsernameBox" Text="admin" Padding="8,6" Margin="0,0,0,12" />
      <TextBlock Text="Password" Margin="0,0,0,4" FontWeight="Medium" />
      <PasswordBox x:Name="PasswordBox" Password="ChangeMe123!" Padding="8,6" Margin="0,0,0,14" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,12">
        <Button Content="Exit" Width="80" Height="34" Margin="0,0,8,0" IsCancel="True" Click="Exit_Click" />
        <Button Content="Sign in" Width="90" Height="34" IsDefault="True" Background="#1769AA" Foreground="White" FontWeight="SemiBold" Click="SignIn_Click" />
      </StackPanel>
      <TextBlock Text="First-run credentials: admin / ChangeMe123!" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
    </StackPanel>
  </Border>
</Window>
