<Window x:Class="BatteryManagement.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Battery Management" Width="1380" Height="860" WindowStartupLocation="CenterScreen">
<DockPanel>
  <Border DockPanel.Dock="Top" Background="#1769AA" Padding="18,10"><DockPanel><StackPanel><TextBlock Text="BATTERY MANAGEMENT" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="UserLabel" Foreground="#DDEEFF"/></StackPanel><TextBlock x:Name="SyncLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="White"/></DockPanel></Border>
  <TabControl x:Name="Tabs">
    <TabItem Header="Dashboard"><ScrollViewer><StackPanel Margin="18"><TextBlock Text="Workshop overview" FontSize="24" FontWeight="SemiBold"/><WrapPanel x:Name="StatsPanel" Margin="0,14"/><TextBlock Text="Recent inventory movements" FontSize="17" FontWeight="SemiBold"/><DataGrid x:Name="MovementGrid" Height="470"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Battery models"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Battery model catalogue" FontSize="20" FontWeight="SemiBold"/><WrapPanel><TextBox x:Name="ModelCodeBox" Width="120" ToolTip="Model code"/><TextBox x:Name="ModelNameBox" Width="180" ToolTip="Model name"/><ComboBox x:Name="ChemistryBox" Width="100" SelectedIndex="0"><ComboBoxItem>LFP</ComboBoxItem><ComboBoxItem>NMC</ComboBoxItem></ComboBox><TextBox x:Name="VoltageBox" Width="90" ToolTip="Nominal voltage"/><TextBox x:Name="CapacityBox" Width="90" ToolTip="Capacity Ah"/><TextBox x:Name="ConfigurationBox" Width="100" ToolTip="Configuration e.g. 16S1P"/><TextBox x:Name="BmsBox" Width="140" ToolTip="BMS specification"/><TextBox x:Name="WarrantyMonthsBox" Width="110" Text="24" ToolTip="Warranty months"/><Button Content="Add model" Click="AddModel_Click"/></WrapPanel><DataGrid x:Name="ModelGrid" Height="600"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Inventory"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Receive imported cells and components" FontSize="20" FontWeight="SemiBold"/><WrapPanel><TextBox x:Name="ComponentNameBox" Width="165" ToolTip="Component/cell name"/><TextBox x:Name="SupplierBox" Width="130" ToolTip="Supplier"/><TextBox x:Name="BatchCodeBox" Width="120" ToolTip="Supplier batch code"/><TextBox x:Name="QuantityBox" Width="90" ToolTip="Quantity"/><TextBox x:Name="CostBox" Width="90" ToolTip="Unit cost"/><TextBox x:Name="LocationBox" Width="120" Text="Main Store" ToolTip="Location"/><TextBox x:Name="ReferenceBox" Width="130" ToolTip="Import/GRN reference"/><Button Content="Receive stock" Click="ReceiveBatch_Click"/></WrapPanel><StackPanel Orientation="Horizontal"><Button Content="Import batches CSV" Click="ImportBatches_Click"/><Button Content="Export inventory CSV" Click="ExportBatches_Click"/></StackPanel><DataGrid x:Name="BatchGrid" Height="570"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Production &amp; QC"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Build battery pack and complete final QC" FontSize="20" FontWeight="SemiBold"/><WrapPanel><ComboBox x:Name="ProductionModelBox" Width="180" DisplayMemberPath="Name" SelectionChanged="ProductionSelectionChanged"/><ComboBox x:Name="ProductionBatchBox" Width="180" DisplayMemberPath="BatchCode"/><TextBox x:Name="ConsumeQtyBox" Width="90" Text="1" ToolTip="Component quantity"/><TextBox x:Name="MeasuredVoltageBox" Width="95" ToolTip="Measured voltage"/><TextBox x:Name="MeasuredCapacityBox" Width="95" ToolTip="Measured capacity Ah"/><TextBox x:Name="HealthBox" Width="85" Text="100" ToolTip="Health percent"/><TextBox x:Name="TesterBox" Width="115" ToolTip="Tester/operator"/><CheckBox x:Name="QcPassBox" Content="QC passed" IsChecked="True" VerticalAlignment="Center" Margin="8"/><Button Content="Build pack" Click="BuildPack_Click"/></WrapPanel><TextBox x:Name="QcNotesBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="QC notes"/><StackPanel Orientation="Horizontal"><Button Content="Generate selected QR label" Click="GenerateLabel_Click"/><Button Content="Export pack list CSV" Click="ExportPacks_Click"/></StackPanel><DataGrid x:Name="PackGrid" Height="540" SelectionChanged="PackGrid_SelectionChanged"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Sales"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Direct retail or dealer stock sale" FontSize="20" FontWeight="SemiBold"/><WrapPanel><ComboBox x:Name="SalePackBox" Width="190" DisplayMemberPath="SerialNumber"/><CheckBox x:Name="DealerSaleBox" Content="Dealer stock sale" VerticalAlignment="Center" Margin="8"/><TextBox x:Name="SalePartyBox" Width="170" ToolTip="Customer or dealer name"/><TextBox x:Name="SalePhoneBox" Width="120" ToolTip="Phone"/><TextBox x:Name="SaleAddressBox" Width="160" ToolTip="Address"/><TextBox x:Name="VehicleBox" Width="110" ToolTip="Vehicle number"/><TextBox x:Name="SaleAmountBox" Width="100" Text="0" ToolTip="Amount"/><Button Content="Complete sale" Click="SellPack_Click"/></WrapPanel><TextBlock Text="Direct retail sales activate warranty immediately. Dealer sales remain unactivated until end-customer registration." Foreground="Gray" Margin="4"/><DataGrid x:Name="SalesGrid" Height="570"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Warranty &amp; claims"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Activate dealer warranty" FontSize="20" FontWeight="SemiBold"/><WrapPanel><ComboBox x:Name="WarrantyPackBox" Width="190" DisplayMemberPath="SerialNumber"/><TextBox x:Name="WarrantyCustomerBox" Width="170" ToolTip="End customer"/><TextBox x:Name="WarrantyPhoneBox" Width="120" ToolTip="Phone"/><TextBox x:Name="WarrantyAddressBox" Width="150" ToolTip="Address"/><TextBox x:Name="WarrantyVehicleBox" Width="110" ToolTip="Vehicle"/><DatePicker x:Name="WarrantyStartPicker"/><Button Content="Activate warranty" Click="ActivateWarranty_Click"/></WrapPanel><TextBlock Text="Open warranty claim" FontSize="20" FontWeight="SemiBold" Margin="4,22,4,4"/><WrapPanel><ComboBox x:Name="ClaimPackBox" Width="190" DisplayMemberPath="SerialNumber"/><TextBox x:Name="ClaimComplaintBox" Width="350" ToolTip="Customer complaint"/><Button Content="Open claim" Click="OpenClaim_Click"/></WrapPanel><WrapPanel><ComboBox x:Name="ResolveClaimBox" Width="180" DisplayMemberPath="ClaimNumber"/><ComboBox x:Name="ClaimOutcomeBox" Width="100" SelectedIndex="0"><ComboBoxItem>Repair</ComboBoxItem><ComboBoxItem>Replace</ComboBoxItem><ComboBoxItem>Reject</ComboBoxItem></ComboBox><ComboBox x:Name="ReplacementPackBox" Width="170" DisplayMemberPath="SerialNumber"/><TextBox x:Name="ClaimNotesBox" Width="250" ToolTip="Inspection/resolution notes"/><Button Content="Resolve claim" Click="ResolveClaim_Click"/></WrapPanel><DataGrid x:Name="WarrantyGrid" Height="220"/><DataGrid x:Name="ClaimsGrid" Height="220"/></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Reports &amp; sync"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Reports, backup, and Google publication" FontSize="20" FontWeight="SemiBold"/><WrapPanel><Button Content="Export all packs CSV" Click="ExportPacks_Click"/><Button Content="Export movements CSV" Click="ExportMovements_Click"/><Button Content="Create local database backup" Click="Backup_Click"/><Button Content="Publish pending QR records" Background="#1769AA" Foreground="White" Click="Sync_Click"/></WrapPanel><Separator Margin="4,12"/><TextBlock Text="Company / QR configuration" FontSize="17" FontWeight="SemiBold"/><WrapPanel><TextBox x:Name="CompanyNameBox" Width="180" ToolTip="Company name"/><TextBox x:Name="SupportBox" Width="180" ToolTip="Support phone/email"/><TextBox x:Name="QrBaseUrlBox" Width="260" ToolTip="Public Apps Script /exec URL"/><TextBox x:Name="AppsScriptUrlBox" Width="260" ToolTip="Apps Script sync URL"/><TextBox x:Name="SyncSecretBox" Width="160" ToolTip="Apps Script shared secret"/><Button Content="Save settings" Click="SaveSettings_Click"/></WrapPanel><TextBlock Text="Local user access" FontSize="17" FontWeight="SemiBold" Margin="4,14,4,4"/><WrapPanel><PasswordBox x:Name="CurrentPasswordBox" Width="140" ToolTip="Current password"/><PasswordBox x:Name="NewPasswordBox" Width="140" ToolTip="New password (10+ characters)"/><Button Content="Change my password" Click="ChangePassword_Click"/><TextBox x:Name="NewUserBox" Width="120" ToolTip="New username"/><PasswordBox x:Name="NewUserPasswordBox" Width="140" ToolTip="New user password (10+ characters)"/><ComboBox x:Name="NewUserRoleBox" Width="100" SelectedIndex="1"><ComboBoxItem>Admin</ComboBoxItem><ComboBoxItem>Operator</ComboBoxItem><ComboBoxItem>Reports</ComboBoxItem></ComboBox><Button Content="Create user" Click="CreateUser_Click"/></WrapPanel><TextBlock Text="Apps Script setup is included in the public-qr folder. The local database remains authoritative when the PC is offline." Foreground="Gray" TextWrapping="Wrap" Margin="4"/><DataGrid x:Name="ReportPacksGrid" Height="420"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
</DockPanel>
</Window>
